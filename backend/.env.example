# Copia este archivo como ".env" y llena los valores reales.
# El archivo .env NO se sube al repositorio.

# ---------------------------------------------------------------------
# Modo: "production" en el servidor. En desarrollo, dejarlo comentado.
# En producción la API también entrega la app web (frontend/dist).
# ---------------------------------------------------------------------
# NODE_ENV=production

# Puerto donde escucha GruaLink
PORT=4000
# (Opcional) Dirección donde escucha. En la nube: 127.0.0.1 (solo el proxy
# HTTPS del mismo servidor llega a la API). Vacío = todas las direcciones.
# HOST=127.0.0.1

# ---------------------------------------------------------------------
# Conexión a PostgreSQL: postgres://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
# Si la contraseña tiene símbolos (@ : / # ?), escríbalos codificados: @ → %40
# ---------------------------------------------------------------------
# DESARROLLO: un solo usuario.
DATABASE_URL=postgres://postgres:cambiar@localhost:5432/GruaLink

# PRODUCCIÓN: la API usa el usuario con permisos mínimos (npm run crear-usuario-app)…
# DATABASE_URL=postgres://grualink_app:CLAVE_APP@localhost:5432/GruaLink
# …y las migraciones, respaldos y restauraciones usan el usuario dueño:
# DATABASE_URL_ADMIN=postgres://postgres:CLAVE_DUENO@localhost:5432/GruaLink

# Horas que dura una sesión antes de expirar (un turno + margen)
SESSION_TTL_HORAS=12

# ---------------------------------------------------------------------
# Publicación (producción)
# ---------------------------------------------------------------------
# Si GruaLink está detrás de un proxy inverso (IIS, Nginx, Caddy), cuántos
# proxies hay delante (normalmente 1). Sin esto, el límite de intentos de
# login vería a todos los usuarios con la IP del proxy.
# TRUST_PROXY=1

# "true" cuando el sitio se publica con HTTPS (activa HSTS y fuerza https)
# SITIO_HTTPS=true

# (Opcional) Carpeta de la app web compilada. Por defecto: ../frontend/dist
# FRONTEND_DIST=C:\GruaLink\frontend\dist

# ---------------------------------------------------------------------
# Respaldos
# ---------------------------------------------------------------------
# Carpeta de respaldos (recomendado: otro disco o carpeta de red)
# RESPALDOS_DIR=D:\Respaldos\GruaLink
# Cuántos respaldos conservar (los más viejos se borran). 0 = no borrar
# RESPALDOS_CONSERVAR=30

# (Opcional) Carpeta de pg_dump / pg_restore si PostgreSQL no está en la ruta
# por defecto (C:\Program Files\PostgreSQL\<versión>\bin). Ej:
# PG_BIN=D:\PostgreSQL\18\bin
