# Copia este archivo como ".env" y llena los valores reales.
# El archivo .env NO se sube al repositorio.

# Puerto donde escucha la API
PORT=4000

# Conexión a PostgreSQL: postgres://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
DATABASE_URL=postgres://postgres:cambiar@localhost:5432/grualink

# Horas que dura una sesión antes de expirar
SESSION_TTL_HORAS=8
